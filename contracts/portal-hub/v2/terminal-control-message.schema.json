{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitalpals.dev/portal-hub/contracts/v2/terminal-control-message.schema.json",
  "title": "Portal Hub API v2 terminal WebSocket control message",
  "oneOf": [
    {
      "type": "object",
      "required": ["type", "session_id"],
      "properties": {
        "type": { "const": "started" },
        "session_id": { "type": "string", "format": "uuid" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "closed" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "message"],
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["type", "uname"],
      "properties": {
        "type": { "const": "os_detected" },
        "uname": { "type": "string", "minLength": 1 },
        "os_release": { "type": "string" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "cols", "rows"],
      "properties": {
        "type": { "const": "resize" },
        "cols": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "rows": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "host", "port", "fingerprint", "key_type"],
      "properties": {
        "type": { "const": "host_key_verification" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "key_type": { "type": "string", "minLength": 1 },
        "old_fingerprint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "accepted"],
      "properties": {
        "type": { "const": "host_key_response" },
        "accepted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "request_id", "filename", "contents_base64"],
      "properties": {
        "type": { "const": "upload_file" },
        "request_id": { "type": "string", "format": "uuid" },
        "filename": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.png$"
        },
        "contents_base64": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["type", "request_id"],
      "properties": {
        "type": { "const": "upload_file_result" },
        "request_id": { "type": "string", "format": "uuid" },
        "path": { "type": "string", "minLength": 1 },
        "error": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["path"], "not": { "required": ["error"] } },
        { "required": ["error"], "not": { "required": ["path"] } }
      ],
      "additionalProperties": false
    }
  ]
}
